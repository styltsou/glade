{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glade",
  "version": "0.1.0",
  "identifier": "com.glade.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
"windows": [
      {
        "title": "Glade",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ]
  }
}
