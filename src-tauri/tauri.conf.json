{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glade",
  "version": "0.2.0",
  "identifier": "com.glade.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glade",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "resizable": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Markdown viewer and editor",
    "linux": {
      "deb": {
        "desktopTemplate": "Glade.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFRjA1RDQ4MkY4MEVGREMKUldUYzc0QXZTRjN3N2trMWNESDFuRTMybldxUVpTNUNNUEk2N3NCWHFIYksxTnVGb1F0MVVmZHIK",
      "endpoints": [
        "https://github.com/styltsou/glade/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
